# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Dependencies
node_modules/

# Build output
dist/
build/

# Environment files
.env
.env.*

# Editor folders
.vscode/
.idea/

# Claude Code local settings (per-user, contains permission allowlist)
.claude/settings.local.json

# Audit report: AUDIT.md is tracked, the rendered HTML view is generated from it
AUDIT.html

# Measurement raw output: a bench writes its raw reading next to itself so the
# report can be re-printed (--from-raw) without re-measuring. Derived data is
# never stored in the repo — it is kept during the session and dropped after.
tools/.*-raw.json
